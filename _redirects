# Every Stripe link for the site lives here, so the pages never need editing
# when a checkout link changes. Replace each REPLACE_... URL with the link
# Stripe gives you (Payment Links and the customer portal login link).
#
# The printed QR code in each issue should point to https://tommystories.com/join
# That opens the plan choice page (/join/), so it keeps working even if a
# Stripe link changes.

/subscribe      /join/                                                   301
/join/monthly   https://buy.stripe.com/REPLACE_MONTHLY_LINK              302
/join/yearly    https://buy.stripe.com/REPLACE_YEARLY_LINK               302
/gift/6         https://buy.stripe.com/REPLACE_GIFT_6_MONTHS_LINK        302
/gift/12        https://buy.stripe.com/REPLACE_GIFT_1_YEAR_LINK          302
/gift/24        https://buy.stripe.com/REPLACE_GIFT_2_YEARS_LINK         302
/manage         https://billing.stripe.com/p/login/REPLACE_PORTAL_LINK   302

# Behind-the-scenes files in the repo aren't pages; don't serve them.
/netlify/*          /404.html   404!
/package.json       /404.html   404!
/package-lock.json  /404.html   404!
/README.md          /404.html   404!
/netlify.toml       /404.html   404!
